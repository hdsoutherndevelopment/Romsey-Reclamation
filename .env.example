# All optional. With none set, the enquiry form validates and shows success but stores/sends nothing (demo mode).

# Resend — emails each enquiry (with photos attached) to the yard, and a receipt to the customer
RESEND_API_KEY=
BUSINESS_EMAIL=
RESEND_FROM=Romsey Reclamation <enquiries@yourdomain.co.uk>

# Supabase — stores every enquiry + photos. Run supabase/migrations/0001_enquiries.sql first. Server-only key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=https://romsey-reclamation.vercel.app
NEXT_PUBLIC_BUSINESS_NAME=Romsey Reclamation
